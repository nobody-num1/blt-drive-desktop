{
  "name": "blt-drive-desktop",
  "version": "0.8.11",
  "description": "BLT Drive Desktop — v0.8.11 : timeout fetch innertube",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "node scripts/download-ytdlp.js",
    "dist": "electron-builder"
  },
  "author": "BLT",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.blt.drive",
    "productName": "BLT Drive Desktop",
    "protocols": [
      { "name": "BLT Drive Desktop", "schemes": ["bltdrive"] }
    ],
    "publish": {
      "provider": "github",
      "owner": "nobody-num1",
      "repo": "blt-drive-desktop"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      },
      {
        "from": "yt-dlp/yt-dlp.exe",
        "to": "yt-dlp/yt-dlp.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "BLT-Drive-Desktop-Setup.exe"
    }
  }
}
